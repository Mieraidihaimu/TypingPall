{
  "id": "py-closeable-bounded-queue",
  "title": "Bounded queue with graceful shutdown",
  "category": "Advanced concurrency",
  "track": "languages",
  "language": "python",
  "summary": "Apply backpressure with a fixed capacity and let consumers drain queued work after close.",
  "code": [
    "from collections import deque",
    "from threading import Condition",
    "",
    "class QueueClosed(Exception):",
    "    pass",
    "",
    "class BoundedQueue:",
    "    def __init__(self, capacity):",
    "        if capacity < 1:",
    "            raise ValueError(\"capacity must be positive\")",
    "        self._capacity = capacity",
    "        self._items = deque()",
    "        self._closed = False",
    "        self._changed = Condition()",
    "",
    "    def put(self, item):",
    "        with self._changed:",
    "            self._changed.wait_for(",
    "                lambda: self._closed or len(self._items) < self._capacity",
    "            )",
    "            if self._closed:",
    "                raise QueueClosed",
    "            self._items.append(item)",
    "            self._changed.notify_all()",
    "",
    "    def get(self):",
    "        with self._changed:",
    "            self._changed.wait_for(lambda: self._closed or self._items)",
    "            if not self._items:",
    "                raise QueueClosed",
    "            item = self._items.popleft()",
    "            self._changed.notify_all()",
    "            return item",
    "",
    "    def close(self):",
    "        with self._changed:",
    "            self._closed = True",
    "            self._changed.notify_all()"
  ],
  "family": "closeable-bounded-queue",
