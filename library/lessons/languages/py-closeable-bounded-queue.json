  "test": [
    "from queue import SimpleQueue",
    "from threading import Event, Thread",
    "",
    "class ObservedCondition(Condition):",
    "    def __init__(self):",
    "        super().__init__()",
    "        self.waiting = Event()",
    "",
    "    def wait(self, timeout=None):",
    "        self.waiting.set()",
    "        return super().wait(timeout)",
    "",
    "def start_waiter(queue, action):",
    "    condition = ObservedCondition()",
    "    queue._changed = condition",
    "    result = SimpleQueue()",
    "    def run():",
    "        try:",
    "            result.put(action())",
    "        except QueueClosed:",
    "            result.put(QueueClosed)",
    "    thread = Thread(target=run, daemon=True)",
    "    thread.start()",
    "    assert condition.waiting.wait(timeout=2), \"Expected action to wait\"",
    "    return result",
    "",
    "q = BoundedQueue(1)",
    "q.put(\"first\")",
    "producer = start_waiter(q, lambda: q.put(\"second\"))",
    "assert q.get() == \"first\"",
    "assert producer.get(timeout=2) is None",
    "blocked = start_waiter(q, lambda: q.put(\"third\"))",
    "q.close()",
    "assert blocked.get(timeout=2) is QueueClosed",
    "assert q.get() == \"second\"",
    "try:",
    "    q.get()",
    "except QueueClosed:",
    "    pass",
    "else:",
    "    raise AssertionError(\"Closed and empty queue must reject get\")",
    "",
    "empty = BoundedQueue(1)",
    "consumer = start_waiter(empty, empty.get)",
    "empty.close()",
    "assert consumer.get(timeout=2) is QueueClosed"
  ],
  "order": 2
}
