{
  "id": "go-interfaces",
  "title": "Small interfaces",
  "category": "Go fundamentals",
  "track": "languages",
  "language": "go",
  "summary": "Types satisfy interfaces implicitly. Accept the behavior you need as a small interface.",
  "code": [
    "package main",
    "",
    "import \"fmt\"",
    "",
    "type Describer interface {",
    "    Describe() string",
    "}",
    "",
    "type Task struct {",
    "    Name string",
    "}",
    "",
    "func (task Task) Describe() string {",
    "    return \"task: \" + task.Name",
    "}",
    "",
    "func printDescription(value Describer) {",
    "    fmt.Println(value.Describe())",
    "}",
    "",
    "func main() {",
    "    printDescription(Task{Name: \"practice\"})",
    "}"
  ],
  "order": 63
}
