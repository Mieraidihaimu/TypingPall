    "def analyze_scores(scores)",
    "    evens = scores.select { |score| score.even? }",
    "    squares = evens.map { |score| score * score }",
    "    total = squares.reduce(0) { |sum, value| sum + value }",
    "    ranked = scores.sort.reverse.each_with_index.to_h",
    "    [squares, total, ranked]",
    "end"
