{
  "id": "go-errors",
  "title": "Errors and multiple returns",
  "category": "Go fundamentals",
  "track": "languages",
  "language": "go",
  "summary": "Check an error before using the accompanying value. fmt.Errorf with %w preserves the underlying error.",
  "code": [
    "package main",
    "",
    "import (",
    "    \"fmt\"",
    "    \"strconv\"",
    ")",
    "",
    "func parsePort(text string) (int, error) {",
    "    port, err := strconv.Atoi(text)",
    "    if err != nil {",
    "        return 0, fmt.Errorf(\"parse port: %w\", err)",
    "    }",
    "    if port < 1 || port > 65535 {",
    "        return 0, fmt.Errorf(\"port out of range\")",
    "    }",
    "    return port, nil",
    "}",
    "",
    "func main() {",
    "    port, err := parsePort(\"8080\")",
    "    if err != nil {",
    "        fmt.Println(err)",
    "        return",
    "    }",
    "    fmt.Println(port)",
    "}"
  ],
  "order": 61
}
