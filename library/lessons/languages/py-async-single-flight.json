  ],
  "mutations": [
    {
      "line": 13,
      "replacement": "        return await task",
      "explanation": "Cancellation now propagates into the shared loader, so the other caller loses its result."
    }
  ],
  "test": [
    "async def exercise():",
    "    started = asyncio.Event()",
    "    release = asyncio.Event()",
    "    joined = asyncio.Event()",
    "    calls = []",
    "",
    "    async def load(key):",
    "        calls.append(key)",
    "        if key == \"bad\" and calls.count(key) == 1:",
    "            raise LookupError(key)",
    "        if key == \"asset\":",
    "            started.set()",
    "            await release.wait()",
    "        return key.upper()",
    "",
    "    flight = SingleFlight(load)",
    "    first = asyncio.create_task(flight.get(\"asset\"))",
    "    await started.wait()",
    "",
    "    async def join():",
    "        joined.set()",
    "        return await flight.get(\"asset\")",
    "",
    "    second = asyncio.create_task(join())",
    "    await joined.wait()",
    "    assert await flight.get(\"other\") == \"OTHER\"",
    "    first.cancel()",
    "    try:",
    "        await first",
    "    except asyncio.CancelledError:",
    "        pass",
    "    else:",
    "        raise AssertionError(\"Waiter should be cancelled\")",
    "    release.set()",
    "    assert await second == \"ASSET\"",
    "    assert calls.count(\"asset\") == 1",
    "    assert await flight.get(\"asset\") == \"ASSET\"",
    "    assert calls.count(\"asset\") == 2",
    "    try:",
    "        await flight.get(\"bad\")",
    "    except LookupError:",
    "        pass",
    "    else:",
    "        raise AssertionError(\"Loader error was lost\")",
    "    assert await flight.get(\"bad\") == \"BAD\"",
    "",
    "asyncio.run(asyncio.wait_for(exercise(), timeout=2))"
  ],
  "order": 3
}
