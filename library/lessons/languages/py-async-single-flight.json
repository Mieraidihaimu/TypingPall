{
  "id": "py-async-single-flight",
  "title": "Single-flight async requests",
  "category": "Advanced concurrency",
  "track": "languages",
  "language": "python",
  "summary": "Share one in-flight task per key and keep one caller’s cancellation from interrupting other waiters.",
  "code": [
    "import asyncio",
    "",
    "class SingleFlight:",
    "    def __init__(self, load):",
    "        self._load = load",
    "        self._pending = {}",
    "",
    "    async def get(self, key):",
    "        task = self._pending.get(key)",
    "        if task is None or task.done():",
    "            task = asyncio.create_task(self._load(key))",
    "            self._pending[key] = task",
    "            task.add_done_callback(lambda done: self._forget(key, done))",
    "        return await asyncio.shield(task)",
    "",
    "    def _forget(self, key, task):",
    "        if self._pending.get(key) is task:",
    "            del self._pending[key]",
    "        if not task.cancelled():",
    "            task.exception()  # Observe failures even if all waiters left."
  ],
  "family": "async-single-flight",
  "triggers": [
    "single-flight request coalescing for concurrent cache misses",
    "asyncio cancellation of one waiter must not cancel shared work"
  ],
  "prompts": [
    "Collapse simultaneous requests for the same asset into one load without caching the result.",
    "Let a caller abandon its wait while another caller still receives the shared result."
  ],
  "invariant": "On one event loop, callers for the same key share the recorded task while it is pending. Cleanup only removes that exact task.",
  "mantra": "Publish the task, shield each wait, evict by identity.",
  "pitfalls": [
    "Awaiting the load before recording it allows overlapping callers to start duplicate work.",
    "Awaiting the shared task without shield lets one cancelled waiter cancel it for everyone.",
    "The load can outlive every waiter. Give expensive I/O its own timeout, and do not reuse the instance across event loops."
  ],
  "keyLineIndices": [
