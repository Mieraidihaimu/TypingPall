{
  "id": "go-defer-recover",
  "title": "Defer and recover",
  "category": "Go fundamentals",
  "track": "languages",
  "language": "go",
  "summary": "Safely intercept panics and clean up resources with deferred functions.",
  "code": [
    "package main",
    "",
    "import \"fmt\"",
    "",
    "func safeDivide(numerator, denominator int) (result int, err error) {",
    "    defer func() {",
    "        if recovered := recover(); recovered != nil {",
    "            err = fmt.Errorf(\"recovered: %v\", recovered)",
    "        }",
    "    }()",
    "    if denominator == 0 {",
    "        panic(\"division by zero\")",
    "    }",
    "    return numerator / denominator, nil",
    "}",
    "",
    "func main() {",
    "    val, err := safeDivide(10, 0)",
    "    if err != nil {",
    "        fmt.Println(err)",
    "        return",
    "    }",
    "    fmt.Println(val)",
    "}"
  ],
  "order": 64
}
