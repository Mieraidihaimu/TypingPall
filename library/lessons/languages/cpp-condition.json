{
  "id": "cpp-condition",
  "title": "Condition variable and a predicate",
  "category": "C++ concurrency",
  "track": "languages",
  "language": "cpp",
  "summary": "C++17. The predicate handles notifications that arrive early and spurious wakeups. Both data and readiness are protected by the same mutex.",
  "code": [
    "#include <condition_variable>",
    "#include <iostream>",
    "#include <mutex>",
    "#include <thread>",
    "",
    "int main() {",
    "    std::mutex mutex;",
    "    std::condition_variable ready;",
    "    bool hasValue = false;",
    "    int value = 0;",
    "    std::thread producer([&] {",
    "        {",
    "            std::lock_guard<std::mutex> lock(mutex);",
    "            value = 42;",
    "            hasValue = true;",
    "        }",
    "        ready.notify_one();",
    "    });",
    "    std::unique_lock<std::mutex> lock(mutex);",
    "    ready.wait(lock, [&] { return hasValue; });",
    "    std::cout << value;",
    "    lock.unlock();",
    "    producer.join();",
    "}"
  ],
  "order": 80
}
