  "test": [
    "def verify(node, low, high):",
    "    if node is None:",
    "        return 0",
    "    assert low < node.key < high",
    "    left = verify(node.left, low, node.key)",
    "    right = verify(node.right, node.key, high)",
    "    assert abs(left - right) <= 1 and node.height == 1 + max(left, right)",
    "    return node.height",
    "for keys in ([3, 2, 1], [3, 1, 2], [1, 2, 3], [1, 3, 2], list(range(40)) + [10]):",
    "    root = None",
    "    for key in keys:",
    "        root = insert(root, key)",
    "        verify(root, float('-inf'), float('inf'))",
    "    def ordered(node):",
    "        return ordered(node.left) + [node.key] + ordered(node.right) if node else []",
    "    assert ordered(root) == sorted(set(keys))"
