  "test": [
    "def verify(node, keys):",
    "    if node is None:",
    "        return 0",
    "    assert not red(node.right)",
    "    assert not (red(node) and red(node.left))",
    "    left = verify(node.left, keys)",
    "    keys.append(node.key)",
    "    right = verify(node.right, keys)",
    "    assert left == right",
    "    return left + int(not node.red)",
    "for sequence in [range(40), reversed(range(40)), [4, 2, 9, 1, 7, 6, 3, 4, 2]]:",
    "    root = None",
    "    seen = set()",
    "    for key in sequence:",
    "        root = insert(root, key)",
    "        seen.add(key)",
    "        keys = []",
    "        verify(root, keys)",
    "        assert keys == sorted(seen) and not root.red"
