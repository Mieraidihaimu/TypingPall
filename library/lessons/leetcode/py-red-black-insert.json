{
  "id": "py-red-black-insert",
  "title": "Left-leaning red-black tree insertion",
  "category": "Python data structures",
  "track": "leetcode",
  "language": "python",
  "summary": "Maintain an ordered set with colored links. Rotations move red links into position and a color flip splits a node with two red children.",
  "code": [
    "class Node:",
    "    def __init__(self, key):",
    "        self.key = key",
    "        self.red = True",
    "        self.left = self.right = None",
    "",
    "def red(node):",
    "    return node is not None and node.red",
    "",
    "def rotate_left(root):",
    "    top = root.right",
    "    root.right, top.left = top.left, root",
    "    top.red, root.red = root.red, True",
    "    return top",
    "",
    "def rotate_right(root):",
    "    top = root.left",
    "    root.left, top.right = top.right, root",
    "    top.red, root.red = root.red, True",
    "    return top",
    "",
    "def insert(root, key):",
    "    def place(node):",
    "        if node is None:",
    "            return Node(key)",
    "        if key < node.key:",
    "            node.left = place(node.left)",
    "        elif key > node.key:",
    "            node.right = place(node.right)",
    "        if red(node.right) and not red(node.left):",
    "            node = rotate_left(node)",
    "        if red(node.left) and red(node.left.left):",
    "            node = rotate_right(node)",
    "        if red(node.left) and red(node.right):",
    "            node.red = True",
    "            node.left.red = node.right.red = False",
    "        return node",
    "",
    "    root = place(root)",
    "    root.red = False",
    "    return root"
  ],
